{
  "manifest_version": 3,
  "name": "vimode",
  "version": "0.1.0",
  "description": "Vim-style keys for the browser, configured from a dotfile, with a qutebrowser-style status bar.",
  "key": "",
  "permissions": ["storage", "nativeMessaging", "sessions", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://web.whatsapp.com/*"],
      "js": ["commands.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
