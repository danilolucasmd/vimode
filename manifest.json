{
  "manifest_version": 3,
  "name": "Vimode",
  "version": "0.1.1",
  "description": "Vim-style keys for the browser, configured from a dotfile, with a qutebrowser-style status bar.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "permissions": [
    "storage",
    "sessions",
    "clipboardWrite",
    "webNavigation",
    "history",
    "bookmarks",
    "search"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "commands.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ]
}
