# Vimode's default keymap, loaded when the extension is first installed and
# again by :importDefaults. To make your own, download it with :exportConfig,
# edit it, and import it with :importConfig (again after every change). The
# file is the whole keymap, with nothing built in underneath: a key does
# something only if a line here maps it. `map <keys> <command>` and
# `set <name> <value>`. Problems (an unknown command, a typo) are listed after
# the import and skip just that line. Press ? for every mapped key, : for
# every command, including the ones mapped to nothing here.

# The settings, at their default values.

# Undo a page focusing a text field as it loads, which would otherwise start
# in insert mode and swallow the first keys meant for here.
set grabBackFocus false

# Let a printable key with no mapping reach the page in normal mode, so a
# site's own shortcuts keep working. Set it to false to drop them instead
# (Google Docs, for one, takes any such key as typing and refocuses its
# editor). Keys with Ctrl or Alt, and arrows, space and Enter, always pass.
set passUnmappedKeys true

# The characters link hints are made of. Their look can be changed by
# importing a style.css alongside this file.
set linkHintCharacters sadfjklewcmpgh

# Pausing halfway through a key sequence shows the keys that continue it,
# after this many ms. Negative turns it off.
set keyhintDelay 500

# How far one scroll step goes, in pixels.
set scrollStepSize 60

# Make scroll commands glide instead of jumping, and keep gliding while the
# key is held.
set smoothScroll false

# Modes
map i enterInsertMode
map : enterCommandMode
map ? showHelp
map gi focusInput

# Link hints. Holding Shift while picking swaps opening in this tab and in a
# new one; Space cycles labels that overlap.
map f LinkHints.activateMode
map F LinkHints.activateModeToOpenInNewTab
map <a-f> LinkHints.activateModeWithQueue
map yf LinkHints.activateModeToCopyLinkUrl

# Find. Lowercase ignores case, a capital makes it exact; Escape clears the
# highlights.
map / enterFindMode
map n performFind
map N performBackwardsFind

# Scrolling
map j scrollDown
map k scrollUp
map h scrollLeft
map l scrollRight
map <c-e> scrollDown
map <c-y> scrollUp
map d scrollPageDown
map u scrollPageUp
map gg scrollToTop
map G scrollToBottom
map zH scrollToLeft
map zL scrollToRight

# History and the address. o opens a URL or searches, O does it in a new tab.
map o open
map O openInNewTab
map H goBack
map L goForward
map gu goUp
map gU goToRoot
map r reload
map yy copyCurrentUrl

# Tabs
map K nextTab
map gt nextTab
map J previousTab
map gT previousTab
map g0 firstTab
map g$ lastTab
map ^ visitPreviousTab
map t createTab
map yt duplicateTab
map x removeTab
map X restoreTab
map <a-p> togglePinTab
map << moveTabLeft
map >> moveTabRight
